ield><field><name>email</name><path>$.reservas[*].member.email</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field></fields><limit>0</limit><IsInFields>N</IsInFields><IsAFile>N</IsAFile><valueField/>
