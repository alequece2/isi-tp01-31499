    <calculation><field_name>data</field_name><calc_type>REMOVE_TIME_FROM_DATE</calc_type><field_a>start</field_a><field_b/><field_c/>
      <value_type>Date</value_type><value_length>-1</value_length><value_precision>-1</value_precision><remove>N</remove>
