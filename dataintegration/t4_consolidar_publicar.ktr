    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Script 1</jsScript_name><jsScript_script>// os campos booleanos vem da BD como objetos Java: compara-se com true/false
var descoberto = (coberto == false);
var tem_luz = (iluminacao == true);
// chuva so interessa nos campos descobertos (limite em %: parametro LIMITE_CHUVA)
var limite = parseInt(getVariable(&quot;LIMITE_CHUVA&quot;, &quot;50&quot;));
var risco_chuva = (descoberto &amp;&amp; prob_chuva != null &amp;&amp; prob_chuva &gt;= limite);
// e_dia = 0 -&gt; ja e de noite, o campo precisa de luz
var precisa_luz = (e_dia != null &amp;&amp; e_dia == 0);
var sem_luz = (precisa_luz &amp;&amp; !tem_luz);</jsScript_script></jsScript></jsScripts><fields><field><name>risco_chuva</name><rename>risco_chuva</rename><type>Boolean</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>precisa_luz</name><rename>precisa_luz</rename><type>Boolean</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>sem_luz</name><rename>sem_luz</rename><type>Boolean</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields>
