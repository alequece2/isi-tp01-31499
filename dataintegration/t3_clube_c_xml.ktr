  <order>
    <hop><from>Ler agenda (XML / XPath)</from><to>Separar hora de início</to><enabled>Y</enabled></hop>
    <hop><from>Separar hora de início</from><to>Separar hora de fim</to><enabled>Y</enabled></hop>
    <hop><from>Separar hora de fim</from><to>Calcular minutos</to><enabled>Y</enabled></hop>
    <hop><from>Calcular minutos</from><to>Normalizar (regex)</to><enabled>Y</enabled></hop>
    <hop><from>Normalizar (regex)</from><to>Validar contacto</to><enabled>Y</enabled></hop>
    <hop><from>Validar contacto</from><to>Traduzir tipo</to><enabled>Y</enabled></hop>
    <hop><from>Traduzir tipo</from><to>Converter data</to><enabled>Y</enabled></hop>
