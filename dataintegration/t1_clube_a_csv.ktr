    <partitionschemas></partitionschemas>
    <slaveservers></slaveservers>
    <clusterschemas></clusterschemas>
    <created_user>31499</created_user>
    <created_date>2026/10/20 16:00:00.000</created_date>
    <modified_user>31499</modified_user>
    <modified_date>2026/10/20 16:00:00.000</modified_date>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>T1 - CLUBE A: CADERNO DO BAR (CSV)
O caderno é escrito à mão e passado para Excel/CSV, por isso vem desarrumado:
datas em 3 formatos, horas como 18h / 18:00 / 18.30, campos como C1 / Campo 1 / court 1, telefones com +351 e espaços.
As expressões regulares põem tudo no mesmo formato, as linhas incompletas vão para um ficheiro de erros,
e o nome e o telefone são removidos (o telefone passa a um código SHA-256 = anonimização).</note>
      <xloc>60</xloc><yloc>420</yloc><width>900</width><heigth>100</heigth>
      <fontname>Segoe UI</fontname><fontsize>9</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred><fontcolorgreen>58</fontcolorgreen><fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>220</backgroundcolorred><backgroundcolorgreen>236</backgroundcolorgreen><backgroundcolorblue>255</backgroundcolorblue>
      <bordercolorred>100</bordercolorred><bordercolorgreen>100</bordercolorgreen><bordercolorblue>100</bordercolorblue>
      <drawshadow>N</drawshadow>
    </notepad>
  </notepads>
  <connection>
    <name>hacampo_pg</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>postgres</database>
    <port>5432</port>
    <username>postgres</username>
    <password>Encrypted 2be98afc86aa7f2e4cb10bd798cc2fd8c</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>5432</attribute></attribute>
      <attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>
  <order>
    <hop><from>Ler caderno (CSV)</from><to>Tirar espaços / maiúsculas</to><enabled>Y</enabled></hop>
    <hop><from>Tirar espaços / maiúsculas</from><to>Normalizar (regex)</to><enabled>Y</enabled></hop>
    <hop><from>Normalizar (regex)</from><to>Validar data</to><enabled>Y</enabled></hop>
    <hop><from>Validar data</from><to>Validar hora</to><enabled>Y</enabled></hop>
    <hop><from>Validar hora</from><to>Validar duração</to><enabled>Y</enabled></hop>
    <hop><from>Validar duração</from><to>Validar telefone</to><enabled>Y</enabled></hop>
    <hop><from>Validar telefone</from><to>Reserva completa?</to><enabled>Y</enabled></hop>
    <hop><from>Reserva completa?</from><to>Erros clube A (CSV)</to><enabled>Y</enabled></hop>
    <hop><from>Reserva completa?</from><to>Converter data</to><enabled>Y</enabled></hop>
    <hop><from>Converter data</from><to>Calcular minutos</to><enabled>Y</enabled></hop>
    <hop><from>Calcular minutos</from><to>Traduzir tipo</to><enabled>Y</enabled></hop>
    <hop><from>Traduzir tipo</from><to>Anonimizar contacto (SHA-256)</to><enabled>Y</enabled></hop>
    <hop><from>Anonimizar contacto (SHA-256)</from><to>Origem e clube</to><enabled>Y</enabled></hop>
    <hop><from>Origem e clube</from><to>Campos finais (sem nome nem telefone)</to><enabled>Y</enabled></hop>
    <hop><from>Campos finais (sem nome nem telefone)</from><to>Gravar staging (BD)</to><enabled>Y</enabled></hop>
    
  </order>
  <step>
    <name>Ler caderno (CSV)</name>
    <type>CsvInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <filename>${Internal.Entry.Current.Directory}/../data/input/clube_a_caderno.csv</filename><filename_field/><rownum_field/><include_filename>N</include_filename>
    <separator>;</separator><enclosure>"</enclosure><header>Y</header><buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion><add_filename_result>N</add_filename_result><parallel>N</parallel>
    <newline_possible>N</newline_possible><encoding>UTF-8</encoding><fields><field><name>data</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>hora</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>duracao</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>campo</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>nome</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>telefone</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>tipo</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>obs</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>60</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Tirar espaços / maiúsculas</name>
    <type>StringOperations</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><in_stream_name>data</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field><field><in_stream_name>hora</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>upper</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field><field><in_stream_name>duracao</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>lower</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field><field><in_stream_name>campo</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>lower</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field><field><in_stream_name>nome</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>lower</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>yes</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field><field><in_stream_name>telefone</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field><field><in_stream_name>tipo</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>upper</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>200</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Normalizar (regex)</name>
    <type>ReplaceString</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><in_stream_name>data</in_stream_name><out_stream_name/><use_regex>yes</use_regex>
      <replace_string>^(\d{2})/(\d{2})/(\d{4})$</replace_string><replace_by_string>$3-$2-$1</replace_by_string><set_empty_string>N</set_empty_string>
      <replace_field_by_string/><whole_word>no</whole_word><case_sensitive>no</case_sensitive><is_unicode>no</is_unicode></field><field><in_stream_name>data</in_stream_name><out_stream_name/><use_regex>yes</use_regex>
      <replace_string>^(\d{2})-(\d{2})-(\d{2})$</replace_string><replace_by_string>20$3-$2-$1</replace_by_string><set_empty_string>N</set_empty_string>
      <replace_field_by_string/><whole_word>no</whole_word><case_sensitive>no</case_sensitive><is_unicode>no</is_unicode></field><field><in_stream_name>hora</in_stream_name><out_stream_name/><use_regex>yes</use_regex>
      <replace_string>^(\d{1,2})[H:.]?$</replace_string><replace_by_string>$1:00</replace_by_string><set_empty_string>N</set_empty_string>
      <replace_field_by_string/><whole_word>no</whole_word><case_sensitive>no</case_sensitive><is_unicode>no</is_unicode></field><field><in_stream_name>hora</in_stream_name><out_stream_name/><use_regex>yes</use_regex>
      <replace_string>^(\d{1,2})[H:.](\d{2})$</replace_string><replace_by_string>$1:$2</replace_by_string><set_empty_string>N</set_empty_string>
      <replace_field_by_string/><whole_word>no</whole_word><case_sensitive>no</case_sensitive><is_unicode>no</is_unicode></field><field><in_stream_name>campo</in_stream_name><out_stream_name/><use_regex>yes</use_regex>
      <replace_string>\D</replace_string><replace_by_string/><set_empty_string>Y</set_empty_string>
      <replace_field_by_string/><whole_word>no</whole_word><case_sensitive>no</case_sensitive><is_unicode>no</is_unicode></field><field><in_stream_name>telefone</in_stream_name><out_stream_name/><use_regex>yes</use_regex>
      <replace_string>\D</replace_string><replace_by_string/><set_empty_string>Y</set_empty_string>
      <replace_field_by_string/><whole_word>no</whole_word><case_sensitive>no</case_sensitive><is_unicode>no</is_unicode></field><field><in_stream_name>telefone</in_stream_name><out_stream_name/><use_regex>yes</use_regex>
      <replace_string>^(00351|351)(\d{9})$</replace_string><replace_by_string>$2</replace_by_string><set_empty_string>N</set_empty_string>
      <replace_field_by_string/><whole_word>no</whole_word><case_sensitive>no</case_sensitive><is_unicode>no</is_unicode></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>340</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Validar data</name>
    <type>RegexEval</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <script><![CDATA[^\d{4}-\d{2}-\d{2}$]]></script><matcher>data</matcher><resultfieldname>data_ok</resultfieldname>
    <usevar>N</usevar><allowcapturegroups>N</allowcapturegroups><replacefields>N</replacefields>
    <canoneq>N</canoneq><caseinsensitive>Y</caseinsensitive><comment>N</comment><dotall>N</dotall><multiline>N</multiline>
    <unicode>N</unicode><unix>N</unix><fields></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>480</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Validar hora</name>
    <type>RegexEval</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <script><![CDATA[^(\d{1,2}):(\d{2})$]]></script><matcher>hora</matcher><resultfieldname>hora_ok</resultfieldname>
    <usevar>N</usevar><allowcapturegroups>Y</allowcapturegroups><replacefields>N</replacefields>
    <canoneq>N</canoneq><caseinsensitive>Y</caseinsensitive><comment>N</comment><dotall>N</dotall><multiline>N</multiline>
    <unicode>N</unicode><unix>N</unix><fields><field><name>h_ini</name><type>Integer</type><format/><group/><decimal/><length>-1</length><precision>-1</precision><nullif/><ifnull/><trimtype>none</trimtype><currency/></field><field><name>m_ini</name><type>Integer</type><format/><group/><decimal/><length>-1</length><precision>-1</precision><nullif/><ifnull/><trimtype>none</trimtype><currency/></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>620</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Validar duração</name>
    <type>RegexEval</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <script><![CDATA[^(?:(\d+)\s*h)?\s*(?:(\d+)\s*(?:min|m)?)?$]]></script><matcher>duracao</matcher><resultfieldname>dur_ok</resultfieldname>
    <usevar>N</usevar><allowcapturegroups>Y</allowcapturegroups><replacefields>N</replacefields>
    <canoneq>N</canoneq><caseinsensitive>Y</caseinsensitive><comment>N</comment><dotall>N</dotall><multiline>N</multiline>
    <unicode>N</unicode><unix>N</unix><fields><field><name>dur_h</name><type>Integer</type><format/><group/><decimal/><length>-1</length><precision>-1</precision><nullif/><ifnull/><trimtype>none</trimtype><currency/></field><field><name>dur_m</name><type>Integer</type><format/><group/><decimal/><length>-1</length><precision>-1</precision><nullif/><ifnull/><trimtype>none</trimtype><currency/></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>760</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Validar telefone</name>
    <type>RegexEval</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <script><![CDATA[^(9[1236]\d{7}|2\d{8})$]]></script><matcher>telefone</matcher><resultfieldname>contacto_valido</resultfieldname>
    <usevar>N</usevar><allowcapturegroups>N</allowcapturegroups><replacefields>N</replacefields>
    <canoneq>N</canoneq><caseinsensitive>Y</caseinsensitive><comment>N</comment><dotall>N</dotall><multiline>N</multiline>
    <unicode>N</unicode><unix>N</unix><fields></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>900</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Reserva completa?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Converter data</send_true_to><send_false_to>Erros clube A (CSV)</send_false_to>
    <compare><condition><negated>N</negated><conditions><condition><negated>N</negated><leftvalue>data_ok</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Boolean</type><text>Y</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value></condition><condition><negated>N</negated><operator>AND</operator><leftvalue>hora_ok</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Boolean</type><text>Y</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value></condition><condition><negated>N</negated><operator>AND</operator><leftvalue>dur_ok</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Boolean</type><text>Y</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value></condition><condition><negated>N</negated><operator>AND</operator><leftvalue>campo</leftvalue><function>IS NOT NULL</function><rightvalue/></condition></conditions></condition></compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>1040</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Erros clube A (CSV)</name>
    <type>TextFileOutput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <separator>;</separator><enclosure>"</enclosure><enclosure_forced>N</enclosure_forced><enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header><footer>N</footer><format>DOS</format><compression>None</compression><encoding>UTF-8</encoding><endedLine/>
    <fileNameInField>N</fileNameInField><fileNameField/><create_parent_folder>Y</create_parent_folder>
    <file><name>${Internal.Entry.Current.Directory}/../data/output/erros_clube_a</name><servlet_output>N</servlet_output><do_not_open_new_file_init>N</do_not_open_new_file_init><extention>csv</extention>
    <append>N</append><split>N</split><haspartno>N</haspartno><add_date>N</add_date><add_time>N</add_time><SpecifyFormat>N</SpecifyFormat>
    <date_time_format/><add_to_result_filenames>Y</add_to_result_filenames><pad>N</pad><fast_dump>N</fast_dump><splitevery>0</splitevery></file>
    <fields><field><name>data</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>both</trim_type><length>-1</length><precision>-1</precision></field><field><name>hora</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>both</trim_type><length>-1</length><precision>-1</precision></field><field><name>duracao</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>both</trim_type><length>-1</length><precision>-1</precision></field><field><name>campo</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>both</trim_type><length>-1</length><precision>-1</precision></field><field><name>nome</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>both</trim_type><length>-1</length><precision>-1</precision></field><field><name>tipo</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>both</trim_type><length>-1</length><precision>-1</precision></field><field><name>obs</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>both</trim_type><length>-1</length><precision>-1</precision></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>1180</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Converter data</name>
    <type>SelectValues</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields><select_unspecified>Y</select_unspecified><meta><name>data</name><rename>data</rename><type>Date</type><length>-2</length><precision>-2</precision>
      <conversion_mask>yyyy-MM-dd</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/>
      <date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/>
      <grouping_symbol/><currency_symbol/><storage_type/></meta></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>1040</xloc><yloc>300</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Calcular minutos</name>
    <type>Calculator</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <calculation><field_name>c60</field_name><calc_type>CONSTANT</calc_type><field_a>60</field_a><field_b/><field_c/>
      <value_type>Integer</value_type><value_length>-1</value_length><value_precision>-1</value_precision><remove>Y</remove>
